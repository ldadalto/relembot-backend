# Copie para .env e preencha os valores

# Chave da API do Claude (Anthropic)
CLAUDE_API_KEY=sk-ant-...

# Token de autenticação do app (gere qualquer string aleatória segura)
# Ex: openssl rand -hex 32
APP_TOKEN=seu_token_secreto_aqui

# Postgres (Railway provisiona automaticamente via addon)
DATABASE_URL=postgres://user:password@host:5432/dbname

# OAuth Client ID (tipo "Web application") criado no Google Cloud Console —
# é o audience usado para validar o ID Token do Google Sign-In do app
GOOGLE_WEB_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Porta (Railway define automaticamente via PORT)
PORT=3000
