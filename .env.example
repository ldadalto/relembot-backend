DATABASE_URL=postgresql://user:password@localhost:5432/relembot
CLAUDE_API_KEY=
GOOGLE_WEB_CLIENT_ID=
# Generate independent random values. Never copy either into an APK.
PURCHASE_TOKEN_KEY=
ADMIN_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/play-service-account.json
PLAY_PACKAGE_NAME=com.relembot.app
CLAUDE_MONTHLY_BUDGET_USD=40
USER_DAILY_BUDGET_USD=1
USER_DAILY_REQUESTS=600
PORT=3000
# Set only to the exact number of trusted reverse proxies in your deployment.
TRUST_PROXY_HOPS=0
# Optional authenticated Pub/Sub push endpoint (also reconciled every minute).
# RTDN_AUDIENCE=https://staging.example.com/billing/rtdn
# RTDN_SERVICE_ACCOUNT_EMAIL=pubsub-push@example.iam.gserviceaccount.com
